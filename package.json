    "bot": "vite-node tools/bot.ts"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "pixi.js": "^8.21.0",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/d3-geo": "^3.1.1",
    "playwright": "1.56.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  }
}
