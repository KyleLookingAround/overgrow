{
  "name": "overgrow",
  "private": true,
  "type": "module",
  "description": "Overgrow: a food-system game from a back garden to the planet, in one static page",
  "homepage": "https://kylelookingaround.github.io/overgrow/",
  "scripts": {
    "dev": "vite",
    "build": "node tools/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
